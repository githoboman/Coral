# Copy to contracts/.env (gitignored) and fill in. TESTNET ONLY — the mainnet
# deploy uses a hardware wallet/multisig, never a key in a file (SEC-13).

# Fresh, single-purpose key generated with `cast wallet new`. Holds faucet ETH
# only. Never reuse it for anything else.
DEPLOYER_PRIVATE_KEY=

# Base Sepolia. Public endpoint is fine for deploys; swap in an Alchemy URL
# when the server chain layer lands (D19 failover pattern).
RPC_URL=https://sepolia.base.org

# Optional: for --verify on Basescan (free key at basescan.org/myapikey)
ETHERSCAN_API_KEY=
