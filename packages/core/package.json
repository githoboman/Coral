{
  "name": "@corral/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "// prepare": "npm runs this after installing this package as a file: dependency, so server/ and app/ get a built dist/ without the deploy having to know about the monorepo. dist/ is gitignored, and main/types point into it, so an unbuilt core breaks every downstream build.",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests && depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "fast-check": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
