# ============================================================================
#  CORAL — FRONTEND ENV (Vercel)
#  Copy to app/.env and fill the values. NEVER commit the filled file.
#  Note: only VITE_* vars are exposed to the browser.
# ============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Your deployed backend URL (the Render service). If unset, the app calls
# http://localhost:3000 — which on a tester's device is THEIR machine (nothing
# there), so every /api/agent/* call fails. This MUST be set on Vercel.
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_SUI_NETWORK=testnet
# Sui JSON-RPC endpoint for the browser (dapp-kit reads/balances). The official
# public fullnode has DEPRECATED JSON-RPC, so leaving this unset makes on-chain
# reads fail. Use a provider that still serves JSON-RPC.
VITE_SUI_RPC_URL=https://sui-testnet-rpc.publicnode.com
# The agent's DeepBook BalanceManager object id (its trading account).
VITE_AGENT_BALANCE_MANAGER=0x...
VITE_MAINTENANCE_MODE=false

# ── OPTIONAL: Google / zkLogin sign-in (Enoki) ──────────────────────────────
# Leave blank to use wallet-extension sign-in only (works without these).
VITE_ENOKI_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# ── DEV-AUTH (demo without Supabase) ────────────────────────────────────────
# Sends the connected wallet as x-dev-wallet so the backend's dev-auth accepts
# it without a Supabase login. The hosted demo currently RELIES on this (there is
# no Supabase configured), so it must be set to "true" on BOTH Vercel (here) and
# the Render backend (AGENT_DEV_AUTH=true). SECURITY: while on, anyone can act as
# any wallet by sending an x-dev-wallet header — fine for a testnet demo, but do
# NOT enable it once real auth / mainnet funds are in play.
VITE_AGENT_DEV_AUTH=true

# ============================================================================
#  LEGACY (Tovira features Coral does not use). Leave unset for the agent demo.
# ============================================================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUI_PACKAGE_ID=
# VITE_SUI_BADGE_PACKAGE_ID=
# VITE_BADGE_REGISTRY_ID=
# VITE_SUI_SUBSCRIPTION_REGISTRY_ID=
# VITE_ETH_RPC_URL=
# VITE_SOLANA_RPC_URL=
# VITE_ENABLE_ONBOARDING=false
